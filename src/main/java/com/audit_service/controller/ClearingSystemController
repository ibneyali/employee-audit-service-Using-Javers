Success Case
it('should fetch client data successfully', () => {

  const formData = {
    clientName: 'Test Client',
    page: 0,
    size: 10
  };

  const mockResponse = {
    status: 'SUCCESS',
    message: 'Data retrieved',
    data: {
      content: [{ clientName: 'Test Client' }],
      totalElements: 1
    }
  };

  service.fetchClientData(formData)
    .subscribe(response => {

      expect(response).toEqual(mockResponse);
      expect(response.data.totalElements).toBe(1);
    });

  const req = httpMock.expectOne(r =>
    r.url === `${API_BASE_MOCK}/client-details`
  );

  expect(req.request.method).toBe('GET');
  expect(req.request.params.get('clientName')).toBe('Test Client');
  expect(req.request.params.get('page')).toBe('0');
  expect(req.request.params.get('size')).toBe('10');

  req.flush(mockResponse);
});
