public static final String UPDATE_STANDARD_PAYMENT = """
    UPDATE IPA_PAYMENT
    SET
        IS_EBA = 'N',
        IS_TARGET = 'N',
        IS_FEDWIRE = 'N',
        IS_MIFT_COMPLETE = 'N',

        T56_INT_BANK = NULL,
        T56_INT_SORTCODE = NULL,
        T56_INT_ACCOUNT = NULL,
        T56_INT_SWIFT = NULL,
        T56_INT_ABA = NULL,

        T57_BENBANK = NULL,
        T57_BENBANK_SORTCODE = NULL,
        T57_BENBANK_ACCOUNT = NULL,
        T57_BENBANK_SWIFT = NULL,
        T57_BENBANK_ABA = NULL,

        T58_59_BENF_NAME = NULL,
        T58_59_BENF_ADDR = NULL,
        T58_59_BENF_ACCOUNT = NULL,
        T58_59_BENF_SWIFT = NULL,
        T58_59_BENF_ABA = NULL,

        T72 = NULL,
        T72_INFO = NULL,

        T50_ACCOUNT = NULL,
        T50_ADDR1 = NULL,
        T50_ADDR2 = NULL,
        T50_ADDR3 = NULL,
        T50_ADDR4 = NULL,

        T52A_SWIFT = NULL,
        T70_REMIT_DETAILS = NULL,
        T71A_CHARGES_BEARER = NULL,

        CHECKER = NULL,
        CHECKER_DT = NULL,

        PART_APPROVED_BY = NULL,
        PART_APPROVED_DT = NULL,

        STATUS = DECODE(STATUS, 'AUTH', 'UNAU', STATUS),
        ACCESS_STAMP = SYSDATE

    WHERE ATRD_REFNO = :tradeRefNo
      AND ISSUE_ID = :issueId
    """;


    @Modifying
@Transactional
@Query(value = IpaPayment.UPDATE_STANDARD_PAYMENT, nativeQuery = true)
int updateStandardPayment(@Param("tradeRefNo") String tradeRefNo,
                          @Param("issueId") String issueId);

                          @Transactional
@Override
public void updatePaymentStatus(String tradeRefNo, String issueId) {

    int rows = ipaPaymentRepository.updateStandardPayment(tradeRefNo, issueId);

    if (rows == 0) {
        throw new IpaPaymentException(ExceptionMessageEnum.PMT_TRADE_REF_NOT_FOUND);
    }

    ipaPaymentReleaseAuditService.insertIpaPaymentAuditTrail(
            tradeRefNo,
            "IPA Payment updated due to Standard Payment modification");
}