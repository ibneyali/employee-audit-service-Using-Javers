@Service
@RequiredArgsConstructor
@Slf4j
@Transactional(readOnly = true)
public class ClientSearchServiceImpl
        implements ClientSearchService {

    private final ClientSearchRepository clientSearchRepository;

    @Override
    public APIResponse<Page<SearchClientResponse>> searchClients(
            String clientName,
            Pageable pageable) {

        String normalizedClientName =
                normalizeString(clientName);

        Page<SearchClientResponse> page =
                clientSearchRepository.searchClients(
                        normalizedClientName,
                        pageable);

        return APIResponse.<Page<SearchClientResponse>>builder()
                .status("SUCCESS")
                .message("Clients retrieved successfully")
                .data(page)
                .total(page.getNumberOfElements())
                .build();
    }

    private String normalizeString(String value) {

        if (value == null || value.trim().isEmpty()) {
            return null;
        }

        return value.trim();
    }
}
