describe('normalizeEntitySearchOptions', () => {

  it('returns response when response is already an array', () => {
    const data = [
      { clientName: 'ABC', clrEntClientId: 100 }
    ];

    const result = (component as any).normalizeEntitySearchOptions(data);

    expect(result).toEqual(data);
  });

  it('returns empty array when response is null', () => {
    const result = (component as any).normalizeEntitySearchOptions(null);

    expect(result).toEqual([]);
  });

  it('returns empty array when response is undefined', () => {
    const result = (component as any).normalizeEntitySearchOptions(undefined);

    expect(result).toEqual([]);
  });

  it('returns empty array when response is not an object', () => {
    const result = (component as any).normalizeEntitySearchOptions('test');

    expect(result).toEqual([]);
  });

  it('returns data array from envelope.data', () => {
    const data = [
      { clientName: 'ABC', clrEntClientId: 100 }
    ];

    const response = {
      data
    };

    const result = (component as any).normalizeEntitySearchOptions(response);

    expect(result).toEqual(data);
  });

  it('returns content array from paged response', () => {
    const data = [
      { clientName: 'XYZ', clrEntClientId: 200 }
    ];

    const response = {
      data: {
        content: data
      }
    };

    const result = (component as any).normalizeEntitySearchOptions(response);

    expect(result).toEqual(data);
  });

  it('returns empty array when data is present but not an array', () => {
    const response = {
      data: {
        clientName: 'ABC'
      }
    };

    const result = (component as any).normalizeEntitySearchOptions(response);

    expect(result).toEqual([]);
  });

  it('returns empty array when content is not an array', () => {
    const response = {
      data: {
        content: 'invalid'
      }
    };

    const result = (component as any).normalizeEntitySearchOptions(response);

    expect(result).toEqual([]);
  });

  it('returns empty array when data is empty object', () => {
    const response = {
      data: {}
    };

    const result = (component as any).normalizeEntitySearchOptions(response);

    expect(result).toEqual([]);
  });

});